{
  "name": "Student",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u00d6\u011frenci ad\u0131 soyad\u0131"
    },
    "phone": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "description": "S\u0131n\u0131f"
    },
    "subject": {
      "type": "string",
      "description": "Bran\u015f/Ders konusu"
    },
    "feePerLesson": {
      "type": "number",
      "description": "Belirlenen ders s\u00fcresi (lessonDuration) ba\u015f\u0131na \u00fccret"
    },
    "lessonDuration": {
      "type": "number",
      "default": 60,
      "description": "Bir dersin dakika cinsinden s\u00fcresi"
    },
    "weeklyLessons": {
      "type": "number",
      "default": 1
    },
    "monthlyFee": {
      "type": "number"
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Haftal\u0131k ders program\u0131 [{day, time}]"
    },
    "parentName": {
      "type": "string"
    },
    "parentPhone": {
      "type": "string"
    },
    "parentEmail": {
      "type": "string"
    },
    "resourceName": {
      "type": "string",
      "description": "Kaynak ad\u0131"
    },
    "initialBalance": {
      "type": "number",
      "default": 0
    },
    "initialBalanceType": {
      "type": "string",
      "enum": [
        "borc",
        "kredi"
      ],
      "default": "borc"
    },
    "inviteCode": {
      "type": "string"
    },
    "inviteAccepted": {
      "type": "boolean",
      "default": false
    },
    "parentInviteSent": {
      "type": "boolean",
      "default": false,
      "description": "Veliye davet e-postas\u0131 g\u00f6nderilip g\u00f6nderilmedi\u011fi"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "teacherEmail": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "pointsAdjustment": {
      "type": "number",
      "default": 0,
      "description": "\u00d6\u011fretmenin manuel puan ekleme/\u00e7\u0131karma miktar\u0131 (ClassDojo tarz\u0131)"
    },
    "pointsNote": {
      "type": "string",
      "description": "Manuel puan d\u00fczenleme notu"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "data.teacherEmail": "{{user.email}}"
    }
  }
}