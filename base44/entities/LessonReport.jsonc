{
  "name": "LessonReport",
  "type": "object",
  "properties": {
    "lessonId": {
      "type": "string"
    },
    "studentId": {
      "type": "string"
    },
    "studentName": {
      "type": "string"
    },
    "teacherEmail": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "subject": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Genel performans puan\u0131 (0-5)"
    },
    "attendance": {
      "type": "string",
      "enum": [
        "kat\u0131ld\u0131",
        "ge\u00e7 kald\u0131",
        "kat\u0131lmad\u0131"
      ],
      "default": "kat\u0131ld\u0131"
    },
    "understood": {
      "type": "string",
      "enum": [
        "tam",
        "kismen",
        "tekrar"
      ],
      "description": "Anlama d\u00fczeyi"
    },
    "participation": {
      "type": "string",
      "enum": [
        "aktif",
        "orta",
        "pasif"
      ],
      "description": "Derse kat\u0131l\u0131m"
    },
    "motivation": {
      "type": "string",
      "enum": [
        "yuksek",
        "normal",
        "dusuk"
      ],
      "description": "Motivasyon d\u00fczeyi"
    },
    "generalNote": {
      "type": "string",
      "description": "Genel de\u011ferlendirme notu"
    },
    "strengths": {
      "type": "string",
      "description": "G\u00fc\u00e7l\u00fc y\u00f6nler"
    },
    "improvements": {
      "type": "string",
      "description": "Geli\u015ftirilmesi gereken alanlar"
    },
    "homework": {
      "type": "string",
      "description": "Verilen \u00f6dev"
    },
    "homeworkDone": {
      "type": "string",
      "enum": [
        "evet",
        "hayir",
        "kismen"
      ],
      "description": "\u00d6nceki \u00f6dev yap\u0131ld\u0131 m\u0131"
    },
    "nextGoal": {
      "type": "string",
      "description": "Bir sonraki ders hedefi"
    },
    "topicsCovered": {
      "type": "string",
      "description": "\u0130\u015flenen konular"
    },
    "pageLeft": {
      "type": "string",
      "description": "Kal\u0131nan sayfa/konu"
    }
  },
  "required": [
    "lessonId",
    "studentId",
    "teacherEmail"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "data.teacherEmail": "{{user.email}}"
    }
  }
}