{
  "name": "Homework",
  "type": "object",
  "properties": {
    "studentId": {
      "type": "string"
    },
    "studentName": {
      "type": "string"
    },
    "teacherEmail": {
      "type": "string"
    },
    "lessonId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "\u00d6dev ba\u015fl\u0131\u011f\u0131"
    },
    "description": {
      "type": "string",
      "description": "\u00d6dev detay\u0131"
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "verildi",
        "goruldu",
        "tamamland\u0131",
        "gecikmi\u015f"
      ],
      "default": "verildi"
    },
    "parentNote": {
      "type": "string",
      "description": "Velinin notu"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Velinin y\u00fckledi\u011fi dosya URL'leri"
    },
    "teacherAttachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u00d6\u011fretmenin y\u00fckledi\u011fi dosya URL'leri"
    },
    "aiEvaluation": {
      "type": "object",
      "description": "AI de\u011ferlendirme sonucu",
      "properties": {
        "effort": {
          "type": "string"
        },
        "understanding": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        }
      }
    },
    "teacherAssessment": {
      "type": "string",
      "enum": [
        "yetersiz",
        "gelistirilmeli",
        "iyi",
        "cok_iyi"
      ],
      "description": "\u00d6\u011fretmenin manuel de\u011ferlendirmesi"
    },
    "teacherNote": {
      "type": "string",
      "description": "\u00d6\u011fretmenin de\u011ferlendirme notu"
    }
  },
  "required": [
    "studentId",
    "teacherEmail",
    "title"
  ],
  "rls": {
    "read": {
      "data.teacherEmail": "{{user.email}}"
    },
    "create": {},
    "update": {
      "data.teacherEmail": "{{user.email}}"
    },
    "delete": {
      "data.teacherEmail": "{{user.email}}"
    }
  }
}