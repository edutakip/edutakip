{
  "name": "Homework",
  "type": "object",
  "properties": {
    "studentId": {
      "type": "string"
    },
    "studentName": {
      "type": "string"
    },
    "teacherEmail": {
      "type": "string"
    },
    "lessonId": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "\u00d6dev ba\u015fl\u0131\u011f\u0131"
    },
    "description": {
      "type": "string",
      "description": "\u00d6dev detay\u0131"
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "verildi",
        "goruldu",
        "tamamland\u0131",
        "gecikmi\u015f"
      ],
      "default": "verildi"
    },
    "parentNote": {
      "type": "string",
      "description": "Velinin notu"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Velinin y\u00fckledi\u011fi dosya URL'leri"
    },
    "teacherAttachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u00d6\u011fretmenin y\u00fckledi\u011fi dosya URL'leri"
    },
    "questions": {
      "type": "array",
      "description": "Etkile\u015fimli sorular (Duolingo tarz\u0131)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "multiple",
              "truefalse",
              "fill"
            ],
            "description": "Soru t\u00fcr\u00fc"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u00c7oktan se\u00e7meli se\u00e7enekler"
          },
          "correctIndex": {
            "type": "number",
            "description": "Do\u011fru se\u00e7ene\u011fin indeksi (multiple/truefalse i\u00e7in)"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Kabul edilen cevaplar (fill i\u00e7in)"
          }
        }
      }
    },
    "gameResult": {
      "type": "object",
      "description": "\u00d6\u011frencinin oyun sonucu",
      "properties": {
        "score": {
          "type": "number",
          "description": "Do\u011fru say\u0131s\u0131"
        },
        "total": {
          "type": "number",
          "description": "Toplam soru say\u0131s\u0131"
        },
        "percentage": {
          "type": "number",
          "description": "Ba\u015far\u0131 y\u00fczdesi"
        }
      }
    },
    "aiEvaluation": {
      "type": "object",
      "description": "AI de\u011ferlendirme sonucu",
      "properties": {
        "effort": {
          "type": "string"
        },
        "understanding": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        }
      }
    },
    "teacherAssessment": {
      "type": "string",
      "enum": [
        "yetersiz",
        "gelistirilmeli",
        "iyi",
        "cok_iyi"
      ],
      "description": "\u00d6\u011fretmenin manuel de\u011ferlendirmesi"
    },
    "teacherNote": {
      "type": "string",
      "description": "\u00d6\u011fretmenin de\u011ferlendirme notu"
    }
  },
  "required": [
    "studentId",
    "teacherEmail",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "data.teacherEmail": "{{user.email}}"
    }
  }
}